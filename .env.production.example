# Required: generate with python3 -c 'import secrets; print(secrets.token_hex(32))'
RANDOMYST_SIGNING_KEY=
# Your actual HTTPS origin, without a path or trailing slash.
RANDOMYST_PUBLIC_ORIGIN=https://arcana.example.com
# Trust only the immediate Dokploy/Traefik proxy IP or dedicated subnet.
# Without this, requests through a proxy share an intentionally conservative IP limit.
RANDOMYST_TRUSTED_PROXIES=
# Maximum outbound AI HTTP attempts per UTC day, including retries/repair passes.
# In-memory counter resets on restart; also set a spending cap with the provider.
RANDOMYST_AI_DAILY_LIMIT=100
# Server-only configuration. Copy to .env.production; never commit real values.
# Leave API key blank to start with local interpretation only.
RANDOMYST_AI_BASE_URL=https://rexapf.com/v1
RANDOMYST_AI_MODEL=claude-sonnet-4-6
RANDOMYST_AI_API_KEY=
RANDOMYST_AI_TIMEOUT_SECONDS=180
