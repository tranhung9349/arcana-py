# Allow only the files needed to build and run Arcana.
**
!Dockerfile
!package.json
!package-lock.json
!requirements-runtime.lock
!dan_gian_config.json
!web/
!web/**
!randomyst/
!randomyst/**
!research_tools/
!research_tools/__init__.py
!research_tools/interpretation_prompt.py
!research_tools/date_interpretation_prompt.py
!research_tools/reading_strategy.py
!config/
!config/**
!schemas/
!schemas/**
!data/
!data/reference/
!data/reference/**
!data/interpretation/
!data/interpretation/**
!data/date_calendar/
!data/date_calendar/**
!docs/
!docs/prompts/
!docs/prompts/**
!deploy/
!deploy/healthcheck.py

# Defense in depth if an allowed directory later contains local files.
**/__pycache__/
**/*.py[cod]
**/.env*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/node_modules/
