{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "kind": {
          "enum": [
            "PRIMARY_TEXT",
            "PRODUCT_POLICY",
            "PROVIDER"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "sha256",
        "url",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "CONDITIONAL",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "status",
        "fact_refs",
        "evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "plain-reading-context-v2",
      "default": "plain-reading-context-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "method": {
      "const": "DATE_SELECTION",
      "default": "DATE_SELECTION",
      "title": "Method",
      "type": "string"
    },
    "analysis_profile": {
      "title": "Analysis Profile",
      "type": "string"
    },
    "topic": {
      "title": "Topic",
      "type": "string"
    },
    "question": {
      "maxLength": 2000,
      "title": "Question",
      "type": "string"
    },
    "signals": {
      "items": {
        "type": "string"
      },
      "title": "Signals",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "context_id",
    "analysis_profile",
    "topic",
    "question",
    "signals",
    "facts",
    "findings",
    "evidence",
    "limitations"
  ],
  "title": "DateReadingContext",
  "type": "object"
}
