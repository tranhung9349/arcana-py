        "type": "integer"
      },
      "title": "Moving Lines",
      "type": "array"
    },
    "najia": {
      "$ref": "#/$defs/NaJiaChart"
    },
    "reading_guide": {
      "items": {
        "type": "string"
      },
      "title": "Reading Guide",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "rules_version",
    "question",
    "casting",
    "calendar",
    "original",
    "changed",
    "moving_lines",
    "najia",
    "reading_guide",
    "limitations",
    "sources"
  ],
  "title": "CoinResponse",
  "type": "object"
}
