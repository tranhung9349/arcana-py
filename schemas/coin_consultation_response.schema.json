    "SourceCard": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text_type": {
          "title": "Text Type",
          "type": "string"
        },
        "language": {
          "enum": [
            "zh",
            "vi"
          ],
          "title": "Language",
          "type": "string"
        },
        "label": {
          "const": "SOURCE_ORIGINAL",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "translation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTranslation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "title",
        "text_type",
        "language",
        "label",
        "text",
        "source",
        "translation"
      ],
      "title": "SourceCard",
      "type": "object"
    },
    "SourceOverview": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "AI_INTERPRETATION",
          "title": "Label",
          "type": "string"
        },
        "language": {
          "const": "vi",
          "title": "Language",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "review_status": {
          "const": "UNREVIEWED",
          "title": "Review Status",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "label",
        "language",
        "text",
        "review_status",
        "references"
      ],
      "title": "SourceOverview",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "enum": [
            "john-walks-slow/open-iching",
            "vhphuoc1102/tinix-bazi"
          ],
          "title": "Repository",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "key",
        "url"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceTranslation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "AI_TRANSLATION",
          "title": "Label",
          "type": "string"
        },
        "language": {
          "const": "vi",
          "title": "Language",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "review_status": {
          "const": "UNREVIEWED",
          "title": "Review Status",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "source_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "label",
        "language",
        "text",
        "review_status",
        "version",
        "references",
        "source_text_sha256"
      ],
      "title": "SourceTranslation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "coin-consultation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "rules_version": {
      "title": "Rules Version",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "casting": {
      "$ref": "#/$defs/CoinCasting"
    },
    "calendar": {
      "additionalProperties": true,
      "title": "Calendar",
      "type": "object"
    },
    "original": {
      "$ref": "#/$defs/CoinReading"
    },
    "changed": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoinReading"
        },
        {
          "type": "null"
        }
      ]
    },
    "moving_lines": {
      "items": {
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6
