          "title": "Changed Stem"
        },
        "changed_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changed Branch"
        },
        "changed_element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changed Element"
        },
        "changed_relative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changed Relative"
        }
      },
      "required": [
        "position",
        "stem",
        "branch",
        "branch_zh",
        "element",
        "relative",
        "spirit",
        "is_world",
        "is_response",
        "moving",
        "void",
        "month_clash",
        "changed_stem",
        "changed_branch",
        "changed_element",
        "changed_relative"
      ],
      "title": "NaJiaLine",
      "type": "object"
