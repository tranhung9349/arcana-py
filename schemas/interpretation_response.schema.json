{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVP 1 AI interpretation response; computational facts stay in the application",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "context_id", "summary", "translations", "interpretations", "limitations"],
  "properties": {
    "schema_version": {"const": "interpretation-response-v1"},
    "context_id": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["label", "content", "references"],
      "properties": {"label": {"const": "AI_INTERPRETATION"}, "content": {"type": "string", "minLength": 1}, "references": {"$ref": "#/$defs/references"}}
    },
    "translations": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "evidence_id", "content"],
        "properties": {"label": {"const": "AI_TRANSLATION"}, "evidence_id": {"type": "string", "minLength": 1}, "content": {"type": "string", "minLength": 1}}
      }
    },
    "interpretations": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "content", "references"],
        "properties": {"label": {"const": "AI_INTERPRETATION"}, "content": {"type": "string", "minLength": 1}, "references": {"$ref": "#/$defs/references"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
