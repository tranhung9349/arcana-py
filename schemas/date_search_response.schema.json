{
  "$defs": {
    "ActivitySpec": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "enum": [
            "MARRIAGE",
            "BUSINESS_OPENING",
            "TRAVEL",
            "HOME_ENTRY",
            "RELOCATION",
            "RENOVATION",
            "TRADE",
            "LAND_BREAKING",
            "ROOF_BEAM",
            "CONTRACT_RITE",
            "PROPERTY_ACQUISITION",
            "RECEIVE_ASSETS",
            "START_EDUCATION",
            "START_JOB",
            "ANCESTOR_RITE",
            "BETROTHAL_NACAI",
            "BETROTHAL_COVENANT",
            "INCENSE_INSTALLATION",
            "BED_SETUP",
            "DEMOLITION",
            "PRAYER"
          ],
          "title": "Activity",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider_token": {
          "title": "Provider Token",
          "type": "string"
        },
        "subject_count": {
          "enum": [
            1,
            2
          ],
          "title": "Subject Count",
          "type": "integer"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "provider_hour_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Hour Token"
        },
        "subject_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Subject Roles",
          "type": "array"
        },
        "hour_evaluation_mode": {
          "enum": [
            "LEGACY_V1",
            "DIRECT_YI_JI",
            "DAY_ONLY"
          ],
          "title": "Hour Evaluation Mode",
          "type": "string"
        },
        "rule_profile": {
          "enum": [
            "LEGACY_V1",
            "CONSTRUCTIVE_V2",
            "RITUAL_V2",
            "DEFERRED"
          ],
          "title": "Rule Profile",
          "type": "string"
        },
        "event_anchor": {
          "title": "Event Anchor",
          "type": "string"
        },
        "scope_note": {
          "title": "Scope Note",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "tier": {
          "enum": [
            "CORE",
            "CONTEXTUAL"
          ],
          "title": "Tier",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "PRODUCT_POLICY",
            "NOT_ENABLED"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "activity",
        "name",
        "provider_token",
        "subject_count",
        "group_id",
        "provider_hour_token",
        "subject_roles",
        "hour_evaluation_mode",
        "rule_profile",
        "event_anchor",
        "scope_note",
        "enabled",
        "tier",
        "review_status"
      ],
      "title": "ActivitySpec",
      "type": "object"
    },
    "DateDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "GOOD",
                "NORMAL",
                "BAD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grade"
        },
        "assessment_state": {
          "enum": [
            "COMPLETE",
            "UNRESOLVED",
            "FILTERED"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/DateWindow"
          },
          "title": "Windows",
          "type": "array"
        },
        "recommended_windows": {
          "items": {
            "$ref": "#/$defs/RecommendedWindow"
          },
          "title": "Recommended Windows",
          "type": "array"
        },
        "evaluated_windows": {
          "minimum": 0,
          "title": "Evaluated Windows",
          "type": "integer"
        },
        "recommended_minutes": {
          "maximum": 1440,
          "minimum": 0,
          "title": "Recommended Minutes",
          "type": "number"
        },
        "has_unresolved_windows": {
          "title": "Has Unresolved Windows",
          "type": "boolean"
        },
        "day_periods": {
          "items": {
            "$ref": "#/$defs/DayAssessment"
          },
          "title": "Day Periods",
          "type": "array"
        },
        "recommended_day_periods": {
          "items": {
            "$ref": "#/$defs/DayPeriod"
          },
          "title": "Recommended Day Periods",
          "type": "array"
        },
        "evaluated_periods": {
          "minimum": 0,
          "title": "Evaluated Periods",
          "type": "integer"
        },
        "hour_evaluation": {
          "enum": [
            "NOT_SUPPORTED",
            "NOT_EVALUATED",
            "HAS_RECOMMENDATIONS",
            "EVALUATED_NO_MATCH"
          ],
          "title": "Hour Evaluation",
          "type": "string"
        }
      },
      "required": [
        "date",
        "grade",
        "assessment_state",
        "score",
        "windows",
        "recommended_windows",
        "evaluated_windows",
        "recommended_minutes",
        "has_unresolved_windows",
        "day_periods",
        "recommended_day_periods",
        "evaluated_periods",
        "hour_evaluation"
      ],
      "title": "DateDay",
      "type": "object"
    },
    "DateSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "path",
        "sha256",
        "url",
        "basis"
      ],
      "title": "DateSource",
      "type": "object"
    },
