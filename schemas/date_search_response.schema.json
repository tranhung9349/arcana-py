          "title": "Hour Branch",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "calendar_class": {
          "enum": [
            "HOANG_DAO",
            "HAC_DAO"
          ],
          "title": "Calendar Class",
          "type": "string"
        },
        "day_officer": {
          "title": "Day Officer",
          "type": "string"
        },
        "tian_shen": {
          "title": "Tian Shen",
          "type": "string"
        },
        "civil_day_ganzhi": {
          "title": "Civil Day Ganzhi",
          "type": "string"
        },
        "bazi_day_ganzhi": {
          "title": "Bazi Day Ganzhi",
          "type": "string"
        },
        "month_ganzhi_exact": {
          "title": "Month Ganzhi Exact",
          "type": "string"
        },
        "lunar": {
          "additionalProperties": true,
          "title": "Lunar",
          "type": "object"
        },
        "day_activity_status": {
          "enum": [
            "SUPPORTED",
            "AVOID",
            "NOT_LISTED",
            "UNRESOLVED"
