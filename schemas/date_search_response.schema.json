          "title": "Day Activity Status",
          "type": "string"
        },
        "hour_activity_status": {
          "enum": [
            "SUPPORTED",
            "AVOID",
            "NOT_LISTED",
            "UNRESOLVED"
          ],
          "title": "Hour Activity Status",
          "type": "string"
        },
        "assessment_state": {
          "enum": [
            "COMPLETE",
            "UNRESOLVED"
          ],
          "title": "Assessment State",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "raw_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Raw Score",
          "type": "integer"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "GOOD",
                "NORMAL",
                "BAD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grade"
        },
        "hard_exclusions": {
          "items": {
            "type": "string"
          },
          "title": "Hard Exclusions",
          "type": "array"
        },
        "penalties": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Penalties",
          "type": "array"
        },
        "subject_assessments": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Subject Assessments",
          "type": "array"
        },
        "facts": {
          "additionalProperties": true,
          "title": "Facts",
          "type": "object"
        },
        "rule_warnings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Rule Warnings",
          "type": "array"
        }
      },
      "required": [
        "start_at",
        "end_at",
        "hour_branch",
        "duration_seconds",
        "calendar_class",
        "day_officer",
        "tian_shen",
        "civil_day_ganzhi",
        "bazi_day_ganzhi",
        "month_ganzhi_exact",
        "lunar",
        "day_activity_status",
        "hour_activity_status",
        "assessment_state",
        "score",
        "raw_score",
        "grade",
        "hard_exclusions",
        "penalties",
        "subject_assessments",
        "facts"
      ],
      "title": "DateWindow",
      "type": "object"
    },
