    },
    "DayPeriod": {
      "additionalProperties": false,
      "description": "Validity interval for a day assessment, never a recommended hour.",
      "properties": {
        "start_at": {
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "title": "End At",
          "type": "string"
        }
      },
      "required": [
        "start_at",
        "end_at"
      ],
      "title": "DayPeriod",
      "type": "object"
    },
    "RecommendedWindow": {
      "additionalProperties": false,
      "description": "Every GOOD interval, in chronological order, without bulky evidence.",
      "properties": {
        "start_at": {
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "title": "End At",
          "type": "string"
        },
        "hour_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ],
          "title": "Hour Branch",
          "type": "string"
        }
      },
      "required": [
        "start_at",
        "end_at",
        "hour_branch"
      ],
      "title": "RecommendedWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "date-search-response-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "date_rules_version": {
      "title": "Date Rules Version",
      "type": "string"
    },
    "calendar_policy": {
      "const": "BEIJING_CIVIL_UTC8",
      "title": "Calendar Policy",
      "type": "string"
    },
    "activity": {
      "enum": [
        "MARRIAGE",
        "BUSINESS_OPENING",
        "TRAVEL",
        "HOME_ENTRY",
        "RELOCATION",
        "RENOVATION",
        "TRADE",
        "LAND_BREAKING",
        "ROOF_BEAM",
        "CONTRACT_RITE",
        "PROPERTY_ACQUISITION",
        "RECEIVE_ASSETS",
        "START_EDUCATION",
        "START_JOB",
        "ANCESTOR_RITE",
        "BETROTHAL_NACAI",
        "BETROTHAL_COVENANT",
        "INCENSE_INSTALLATION",
        "BED_SETUP",
        "DEMOLITION",
        "PRAYER"
      ],
      "title": "Activity",
      "type": "string"
    },
    "activity_name": {
      "title": "Activity Name",
      "type": "string"
    },
    "disabled_rules": {
      "items": {
        "type": "string"
      },
      "title": "Disabled Rules",
      "type": "array"
    },
    "coverage_note": {
      "title": "Coverage Note",
      "type": "string"
    },
    "subject_summaries": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Subject Summaries",
      "type": "array"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/DateDay"
      },
      "title": "Days",
      "type": "array"
    },
    "evaluated_windows": {
      "title": "Evaluated Windows",
      "type": "integer"
    },
    "personal_comparisons": {
      "title": "Personal Comparisons",
      "type": "integer"
    },
    "natal_analysis_count": {
      "title": "Natal Analysis Count",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DateSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Warnings",
      "type": "array"
    },
    "activity_registry_version": {
      "title": "Activity Registry Version",
      "type": "string"
    },
    "activity_spec": {
      "$ref": "#/$defs/ActivitySpec"
    },
    "evaluation_mode": {
      "enum": [
        "DAY_ONLY",
        "DAY_AND_HOUR"
      ],
      "title": "Evaluation Mode",
      "type": "string"
    },
    "evaluated_periods": {
      "minimum": 0,
      "title": "Evaluated Periods",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "date_rules_version",
    "calendar_policy",
    "activity",
    "activity_name",
    "disabled_rules",
    "coverage_note",
    "subject_summaries",
    "days",
