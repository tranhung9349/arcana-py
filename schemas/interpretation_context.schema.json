{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVP 1 Vietnamese interpretation context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "rules_version",
    "question",
    "computed_facts",
    "display_hexagrams",
    "evidence",
    "source_gaps",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "interpretation-context-v1"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "rules_version": {
      "enum": [
        "mvp1-logic-2026-10-11-v2",
        "mvp1-logic-2026-10-11-v3",
        "mvp1-logic-2026-10-11-v4",
        "mvp1-logic-2026-10-26-v5",
        "mvp1-logic-2026-10-26-v6"
      ]
    },
    "question": {
      "type": "string"
    },
    "computed_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_useful_element",
        "bazi_source",
        "maihoa",
        "number_result",
        "time_context"
      ],
      "properties": {
        "primary_useful_element": {
          "$ref": "#/$defs/element"
        },
        "bazi_source": {
          "type": "string",
          "minLength": 1
        },
        "maihoa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_version",
            "variables",
            "upper",
            "lower",
            "moving_line",
            "original",
            "the_element",
            "dung_element",
            "state"
          ],
          "properties": {
            "core_version": {
              "const": "maihoa-ymdh-v1"
            },
            "variables": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Y",
                "M",
                "D",
                "H"
              ],
              "properties": {
                "Y": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "M": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "D": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "H": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              }
            },
            "upper": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "lower": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "moving_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "original": {
              "$ref": "#/$defs/hexagram"
            },
            "the_element": {
              "$ref": "#/$defs/element"
            },
            "dung_element": {
              "$ref": "#/$defs/element"
            },
            "state": {
              "enum": [
                "DAI_CAT",
                "THU_CAT",
                "BINH_HOA",
                "TIEU_HAO",
                "DAI_HUNG"
              ]
            }
          }
        },
        "number_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numbers",
            "status",
            "score",
            "threshold",
            "G_raw",
            "G_cap",
            "attempts",
            "remediation"
          ],
          "properties": {
            "numbers": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              }
            },
            "status": {
              "enum": [
                "OPTIMAL",
                "SUB_OPTIMAL"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "enum": [
                70,
                75,
                80,
                85
              ]
            },
            "G_raw": {
              "type": "number",
              "minimum": -290,
              "maximum": 200
            },
            "G_cap": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 200
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "remediation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "target_element",
                "quota_min",
                "quota_max"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "target_element": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/element"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quota_min": {
                  "const": 3
                },
                "quota_max": {
                  "const": 4
                }
              }
            }
          }
        },
        "time_context": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "civil_datetime",
                "actual_utc_instant",
                "tst_clock",
                "effective_date",
                "calendar_algorithm_id",
                "calendar_validation_status",
                "boundary_status"
              ],
              "properties": {
                "civil_datetime": {
                  "type": "string",
                  "minLength": 1
                },
                "actual_utc_instant": {
                  "type": "string",
                  "minLength": 1
                },
                "tst_clock": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_date": {
                  "type": "string",
                  "minLength": 1
                },
                "calendar_algorithm_id": {
                  "const": "hnd-simplified-vn-utc7-v0.1"
                },
                "calendar_validation_status": {
                  "enum": [
                    "EXPERIMENTAL",
                    "VALIDATED_ON_ACCEPTANCE_CORPUS"
                  ]
                },
                "boundary_status": {
                  "enum": [
                    "WITHIN_KNOWN_UNCERTAINTY",
                    "CLEAR_WITHIN_KNOWN_UNCERTAINTY",
                    "UNKNOWN_UNCERTAINTY"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "civil_datetime",
                "actual_utc_instant",
                "beijing_datetime",
                "effective_date",
                "calendar_algorithm_id",
                "calendar_validation_status",
                "boundary_status",
                "true_solar_time_applied"
              ],
              "properties": {
                "civil_datetime": {
                  "type": "string",
                  "minLength": 1
                },
                "actual_utc_instant": {
                  "type": "string",
                  "minLength": 1
                },
                "beijing_datetime": {
                  "type": "string",
                  "pattern": "\\+08:00$"
                },
                "effective_date": {
                  "type": "string",
                  "minLength": 1
                },
                "calendar_algorithm_id": {
                  "const": "6tail-chinese-utc8-v1"
                },
                "calendar_validation_status": {
                  "enum": [
                    "INTEGRATION_TESTED",
                    "VALIDATED_ON_ACCEPTANCE_CORPUS"
                  ]
                },
                "boundary_status": {
                  "enum": [
                    "WITHIN_KNOWN_UNCERTAINTY",
                    "CLEAR_WITHIN_KNOWN_UNCERTAINTY",
                    "UNKNOWN_UNCERTAINTY"
                  ]
                },
                "true_solar_time_applied": {
                  "const": false
                }
              }
            }
          ]
        }
      }
    },
    "display_hexagrams": {
      "description": "Prepared data for on-demand display. No effect on scoring, sampling, remediation or core Mai Hoa.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutual",
        "changed",
        "affects_generation",
        "affects_evaluation",
        "display_on_demand"
      ],
      "properties": {
        "mutual": {
          "anyOf": [
            {
              "$ref": "#/$defs/hexagram"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed": {
          "anyOf": [
            {
              "$ref": "#/$defs/hexagram"
            },
            {
              "type": "null"
            }
          ]
        },
        "affects_generation": {
          "const": false
        },
        "affects_evaluation": {
          "const": false
        },
        "display_on_demand": {
          "const": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "source_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_evidence_id",
          "reason"
        ],
        "properties": {
          "expected_evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "element": {
      "enum": [
        "Mộc",
        "Hỏa",
        "Thổ",
        "Kim",
        "Thủy"
      ]
    },
    "hexagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_zh",
        "lines_bottom_to_top",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "lines_bottom_to_top": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "enum": [
              0,
              1
            ]
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "label",
        "text_kind",
        "hexagram_id",
        "line_position",
        "language",
        "text",
        "source"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "const": "SOURCE_ORIGINAL"
        },
        "text_kind": {
          "enum": [
            "HEXAGRAM_TEXT",
            "LINE_TEXT",
            "TUAN",
            "XIANG",
            "BAZI_RULE"
          ]
        },
        "hexagram_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 64
        },
        "line_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "language": {
          "enum": [
            "zh",
            "vi"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "path",
            "record_key",
            "url"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "record_key": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rules_version": {"enum": ["mvp1-logic-2026-10-11-v2", "mvp1-logic-2026-10-11-v3", "mvp1-logic-2026-10-11-v4"]}
        }
      },
      "then": {
        "properties": {
          "computed_facts": {
            "properties": {
              "number_result": {
                "properties": {
                  "numbers": {"items": {"pattern": "^(0[0-9]|[1-3][0-9]|4[0-5])$"}}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rules_version": {
            "enum": ["mvp1-logic-2026-10-11-v4", "mvp1-logic-2026-10-26-v5", "mvp1-logic-2026-10-26-v6"]
          }
        }
      },
      "then": {
        "properties": {
          "computed_facts": {
            "properties": {
              "time_context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "civil_datetime",
                  "actual_utc_instant",
                  "beijing_datetime",
                  "effective_date",
                  "calendar_algorithm_id",
                  "calendar_validation_status",
                  "boundary_status",
                  "true_solar_time_applied"
                ],
                "properties": {
                  "civil_datetime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_utc_instant": {
                    "type": "string",
                    "minLength": 1
                  },
                  "beijing_datetime": {
                    "type": "string",
                    "pattern": "\\+08:00$"
                  },
                  "effective_date": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calendar_algorithm_id": {
                    "const": "6tail-chinese-utc8-v1"
                  },
                  "calendar_validation_status": {
                    "enum": [
                      "INTEGRATION_TESTED",
                      "VALIDATED_ON_ACCEPTANCE_CORPUS"
                    ]
                  },
                  "boundary_status": {
                    "enum": [
                      "WITHIN_KNOWN_UNCERTAINTY",
                      "CLEAR_WITHIN_KNOWN_UNCERTAINTY",
                      "UNKNOWN_UNCERTAINTY"
                    ]
                  },
                  "true_solar_time_applied": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "computed_facts": {
            "properties": {
              "time_context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "civil_datetime",
                  "actual_utc_instant",
                  "tst_clock",
                  "effective_date",
                  "calendar_algorithm_id",
                  "calendar_validation_status",
                  "boundary_status"
                ],
                "properties": {
                  "civil_datetime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_utc_instant": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tst_clock": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effective_date": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calendar_algorithm_id": {
                    "const": "hnd-simplified-vn-utc7-v0.1"
                  },
                  "calendar_validation_status": {
                    "enum": [
                      "EXPERIMENTAL",
                      "VALIDATED_ON_ACCEPTANCE_CORPUS"
                    ]
                  },
                  "boundary_status": {
                    "enum": [
                      "WITHIN_KNOWN_UNCERTAINTY",
                      "CLEAR_WITHIN_KNOWN_UNCERTAINTY",
                      "UNKNOWN_UNCERTAINTY"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
