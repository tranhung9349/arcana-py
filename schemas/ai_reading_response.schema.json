{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "AI_INTERPRETATION",
          "default": "AI_INTERPRETATION",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 1400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fact_refs",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "plain-reading-context-v2",
          "default": "plain-reading-context-v2",
          "title": "Schema Version",
          "type": "string"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "BAZI_NATAL_V1",
            "MAIHOA_INTERNAL",
            "LIUYAO_NAJIA",
            "ZHOUYI_TEXT"
          ],
          "title": "Method",
          "type": "string"
        },
        "analysis_profile": {
          "title": "Analysis Profile",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "title": "Question",
          "type": "string"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "method",
        "analysis_profile",
        "topic",
        "question",
        "signals",
        "facts",
        "findings",
        "evidence",
        "limitations"
      ],
      "title": "Context",
      "type": "object"
    },
    "DateReadingContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "plain-reading-context-v2",
          "default": "plain-reading-context-v2",
          "title": "Schema Version",
          "type": "string"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "method": {
          "const": "DATE_SELECTION",
          "default": "DATE_SELECTION",
          "title": "Method",
          "type": "string"
        },
        "analysis_profile": {
          "title": "Analysis Profile",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "title": "Question",
          "type": "string"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "analysis_profile",
        "topic",
        "question",
        "signals",
        "facts",
        "findings",
        "evidence",
        "limitations"
      ],
      "title": "DateReadingContext",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "kind": {
          "enum": [
            "PRIMARY_TEXT",
            "PRODUCT_POLICY",
            "PROVIDER"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "sha256",
        "url",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "CONDITIONAL",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "status",
        "fact_refs",
        "evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LifeReading": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bazi-life-reading-v1",
          "default": "bazi-life-reading-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "analysis_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Analysis Sha256",
          "type": "string"
        },
        "overview": {
          "$ref": "#/$defs/NarrativeBlock"
        },
        "tendencies": {
          "items": {
            "$ref": "#/$defs/LifeTendency"
          },
          "maxItems": 5,
          "title": "Tendencies",
          "type": "array"
        },
        "in_life": {
          "items": {
            "$ref": "#/$defs/LifeSection"
          },
          "maxItems": 3,
          "title": "In Life",
          "type": "array"
        },
        "contradictions": {
          "items": {
            "$ref": "#/$defs/NarrativeBlock"
          },
          "maxItems": 3,
          "title": "Contradictions",
          "type": "array"
        },
        "takeaway": {
          "$ref": "#/$defs/NarrativeBlock"
        },
        "limits": {
          "items": {
            "$ref": "#/$defs/ReaderLimit"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Limits",
          "type": "array"
        },
        "disclaimer": {
          "const": "Đây là cách diễn giải theo hệ thống truyền thống, không phải đánh giá tính cách hay dự đoán khoa học.",
          "default": "Đây là cách diễn giải theo hệ thống truyền thống, không phải đánh giá tính cách hay dự đoán khoa học.",
          "title": "Disclaimer",
          "type": "string"
        },
        "whole_life": {
          "anyOf": [
            {
              "$ref": "#/$defs/WholeLifeReading"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "context_id",
        "analysis_sha256",
        "overview",
        "tendencies",
        "in_life",
        "contradictions",
        "takeaway",
        "limits"
      ],
      "title": "LifeReading",
      "type": "object"
    },
    "LifeSection": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 9000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "pattern_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Pattern Refs",
          "type": "array"
        },
        "manifestation_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Manifestation Refs",
          "type": "array"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Condition Refs",
          "type": "array"
        },
        "limit_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Limit Refs",
          "type": "array"
        },
        "title": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "domains": {
          "items": {
            "enum": [
              "LEARNING",
              "DECISIONS",
              "ACTION",
              "PRESSURE",
              "WORK",
              "COOPERATION",
              "FINANCES",
              "RELATIONSHIPS",
              "ADAPTATION"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        }
      },
      "required": [
        "text",
        "pattern_refs",
        "manifestation_refs",
        "condition_refs",
        "limit_refs",
        "title",
        "domains"
      ],
      "title": "LifeSection",
      "type": "object"
    },
    "LifeTendency": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 9000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "pattern_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Pattern Refs",
          "type": "array"
        },
        "manifestation_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Manifestation Refs",
          "type": "array"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Condition Refs",
          "type": "array"
        },
        "limit_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Limit Refs",
          "type": "array"
        },
        "pattern_id": {
          "pattern": "^P0[1-5]$",
          "title": "Pattern Id",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "text",
        "pattern_refs",
        "manifestation_refs",
        "condition_refs",
        "limit_refs",
        "pattern_id",
        "title"
      ],
      "title": "LifeTendency",
      "type": "object"
    },
    "NarrativeBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 9000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "pattern_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Pattern Refs",
          "type": "array"
        },
        "manifestation_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Manifestation Refs",
          "type": "array"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Condition Refs",
          "type": "array"
        },
        "limit_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Limit Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "pattern_refs",
        "manifestation_refs",
        "condition_refs",
        "limit_refs"
      ],
      "title": "NarrativeBlock",
      "type": "object"
    },
    "PipelineProvenance": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "bazi-two-stage-tinix-2026-10-29-v5",
          "default": "bazi-two-stage-tinix-2026-10-29-v5",
          "title": "Version",
          "type": "string"
        },
        "analysis_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Analysis Sha256",
          "type": "string"
        },
        "analyst_passes": {
          "maximum": 2,
          "minimum": 1,
          "title": "Analyst Passes",
          "type": "integer"
        },
        "interpreter_passes": {
          "maximum": 2,
          "minimum": 1,
          "title": "Interpreter Passes",
          "type": "integer"
        },
        "analyst_model": {
          "title": "Analyst Model",
          "type": "string"
        },
        "interpreter_model": {
          "title": "Interpreter Model",
          "type": "string"
        }
      },
      "required": [
        "analysis_sha256",
        "analyst_passes",
        "interpreter_passes",
        "analyst_model",
        "interpreter_model"
      ],
      "title": "PipelineProvenance",
      "type": "object"
    },
    "PortraitAreaText": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "area": {
          "enum": [
            "CAREER",
            "FINANCES",
            "RELATIONSHIPS"
          ],
          "title": "Area",
          "type": "string"
        },
        "text": {
          "maxLength": 9000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "area",
        "text"
      ],
      "title": "PortraitAreaText",
      "type": "object"
    },
    "PortraitPeriodText": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^V0[1-3]$",
          "title": "Id",
          "type": "string"
        },
        "cycle_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Cycle Indices",
          "type": "array"
        },
        "start_year": {
          "title": "Start Year",
          "type": "integer"
        },
        "end_year": {
          "title": "End Year",
          "type": "integer"
        },
        "start_age": {
          "title": "Start Age",
          "type": "integer"
        },
        "end_age": {
          "title": "End Age",
          "type": "integer"
        },
        "text": {
          "maxLength": 9000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "cycle_indices",
        "start_year",
        "end_year",
        "start_age",
        "end_age",
        "text"
      ],
      "title": "PortraitPeriodText",
      "type": "object"
    },
    "PracticalOption": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "MODERN_APPLICATION",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text",
        "fact_refs"
      ],
      "title": "PracticalOption",
      "type": "object"
    },
    "ReaderLimit": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_refs"
      ],
      "title": "ReaderLimit",
      "type": "object"
    },
    "Response": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "plain-reading-response-v2",
          "default": "plain-reading-response-v2",
          "title": "Schema Version",
          "type": "string"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Claim"
        },
        "analysis": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Analysis",
          "type": "array"
        },
        "practical_options": {
          "items": {
            "$ref": "#/$defs/PracticalOption"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Practical Options",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Limits",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "summary",
        "analysis",
        "practical_options",
        "limits"
      ],
      "title": "Response",
      "type": "object"
    },
    "WholeLifeReading": {
      "additionalProperties": false,
      "properties": {
        "areas": {
          "items": {
            "$ref": "#/$defs/PortraitAreaText"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Areas",
          "type": "array"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/PortraitPeriodText"
          },
          "maxItems": 3,
          "title": "Periods",
          "type": "array"
        },
        "timing_status": {
          "enum": [
            "AVAILABLE",
            "NOT_AVAILABLE"
          ],
          "title": "Timing Status",
          "type": "string"
        },
        "timing_note": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Timing Note",
          "type": "string"
        }
      },
      "required": [
        "areas",
        "periods",
        "timing_status",
        "timing_note"
      ],
      "title": "WholeLifeReading",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ai-reading-v1",
      "default": "ai-reading-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "reading_id": {
      "title": "Reading Id",
      "type": "string"
    },
    "consultation_id": {
      "format": "uuid",
      "title": "Consultation Id",
      "type": "string"
    },
    "method": {
      "enum": [
        "BAZI",
        "MAIHOA",
        "LIUYAO",
        "DATE"
      ],
      "title": "Method",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "model_requested": {
      "title": "Model Requested",
      "type": "string"
    },
    "model_returned": {
      "title": "Model Returned",
      "type": "string"
    },
    "provider_host": {
      "title": "Provider Host",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Case Ids",
      "type": "array"
    },
    "context_sha256": {
      "title": "Context Sha256",
      "type": "string"
    },
    "model_called": {
      "const": true,
      "default": true,
      "title": "Model Called",
      "type": "boolean"
    },
    "validation": {
      "const": "SCHEMA_AND_REFERENCES_CHECKED",
      "default": "SCHEMA_AND_REFERENCES_CHECKED",
      "title": "Validation",
      "type": "string"
    },
    "usage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Usage",
      "type": "object"
    },
    "generation_passes": {
      "default": 1,
      "maximum": 4,
      "minimum": 1,
      "title": "Generation Passes",
      "type": "integer"
    },
    "pipeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/Context"
        },
        {
          "$ref": "#/$defs/DateReadingContext"
        }
      ],
      "title": "Context"
    },
    "reading": {
      "discriminator": {
