  },
  {
    "id": "ziping:use",
    "title": "Tử Bình Chân Thuyên · Luận Dụng thần",
    "text": "八字用神，專求月令",
    "sha256": "8f82b286eca6fa26c92c8a44b7c74dce4855e766526ab13088c5bb692baadd68",
    "url": "https://www.donglishuzhai.net/chapter/3721.html",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": null,
    "source_state": "WEB_EXCERPT_NOT_EDITION_PINNED"
  },
  {
    "id": "ziping:formation",
    "title": "Tử Bình Chân Thuyên · Thành bại cứu ứng",
    "text": "用神專求月令，然以四柱配之，必有成敗。",
    "sha256": "72aaf670e49b403b9c60a4ed7e8befb1cc5560610655c769fd36fdaf45f16887",
    "url": "https://www.donglishuzhai.net/chapter/3722.html",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": null,
    "source_state": "WEB_EXCERPT_NOT_EDITION_PINNED"
  },
  {
    "id": "ziping:climate",
    "title": "Tử Bình Chân Thuyên · Phối khí hậu",
    "text": "論命惟以月令用神爲主，然亦須配氣候而互參之。",
    "sha256": "1209ff3ce05b85b9baa67f4c860796b283cf384826917002e02873c72682a4f7",
    "url": "https://www.donglishuzhai.net/chapter/3727.html",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": null,
    "source_state": "WEB_EXCERPT_NOT_EDITION_PINNED"
  },
  {
    "id": "mh:roles",
    "title": "Mai Hoa Dịch Số · Thể và Dụng",
    "text": "體為主，用為事。",
    "sha256": "258e7ec60a6925d721464a76037c00bb38c31dc2913f460992bec170aa4e7320",
    "url": "https://zh.wikisource.org/w/index.php?oldid=1441921",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "MAIHOA_INTERNAL"
    ],
    "raw_path": "data/reference/maihoa/volume_2.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "mh:sequence",
    "title": "Mai Hoa Dịch Số · Diễn tiến Hỗ và Biến",
    "text": "用吉變凶者，先吉後凶；用凶變吉者，先凶後吉。",
    "sha256": "5cc5bfa3eca79356bb093eed612e9d159994440f342f3ac33260cecfb41787fe",
    "url": "https://zh.wikisource.org/w/index.php?oldid=1441921",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "MAIHOA_INTERNAL"
    ],
    "raw_path": "data/reference/maihoa/volume_2.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "mh:wealth",
    "title": "Mai Hoa Dịch Số · Cầu tài",
    "text": "體生用，財有損耗之憂；用生體，財有進益之喜。",
    "sha256": "8174472750d15f6cb14fb0de3554742ee9c0e5a5788807a5a2b9c6216748bd5c",
    "url": "https://zh.wikisource.org/w/index.php?oldid=1441921",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "MAIHOA_INTERNAL"
    ],
    "raw_path": "data/reference/maihoa/volume_2.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "mh:trade",
    "title": "Mai Hoa Dịch Số · Giao dịch",
    "text": "體生用，難成，或因交易有失。用生體，即成，成必有財。",
    "sha256": "7e6ffa2d6e78879ca5d6fabd1cdd056aa36798380e50e4bc00ac8fe69022d8a3",
    "url": "https://zh.wikisource.org/w/index.php?oldid=1441921",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "MAIHOA_INTERNAL"
    ],
    "raw_path": "data/reference/maihoa/volume_2.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "mh:planning",
    "title": "Mai Hoa Dịch Số · Mưu sự",
    "text": "體克用，謀雖可成，但成遲。用克體，求謀不成，謀亦有害。",
    "sha256": "e5fcdd3ded09efbadfb88798b4e318e394885e82477164a2b902a5435745036b",
    "url": "https://zh.wikisource.org/w/index.php?oldid=1441921",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "MAIHOA_INTERNAL"
    ],
    "raw_path": "data/reference/maihoa/volume_2.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "ly:wealth",
    "title": "Tăng San Bốc Dịch · Dụng thần · Tài vật",
    "text": "一切使用之財物亦以妻財爻爲用神。",
    "sha256": "eca1164de968e99ca9c191aa70d5b0f331ebdc0a303217c97e5b7b23f78443b4",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2100700",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "LIUYAO_NAJIA"
    ],
    "raw_path": "data/reference/interpretation/zsby_8.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "ly:document",
    "title": "Tăng San Bốc Dịch · Dụng thần · Văn thư",
    "text": "章奏、文書及書館文契也以父母爻爲用神",
    "sha256": "320c662df868c6c56be23aacc6dabfafbb05592515e17fb9e451caf77dffa4c5",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2100700",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "LIUYAO_NAJIA"
    ],
    "raw_path": "data/reference/interpretation/zsby_8.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "ly:roles",
    "title": "Tăng San Bốc Dịch · Nguyên thần và Kỵ thần",
    "text": "元神，生用神之神卽爲元神。忌神克用神之爻也。",
    "sha256": "ba52cc71432f8a081822ebd4df9034e48a8f68340cf339150307f8284d4815f8",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2100299",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "LIUYAO_NAJIA"
    ],
    "raw_path": "data/reference/interpretation/zsby_9.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "ly:month",
    "title": "Tăng San Bốc Dịch · Nguyệt tướng",
    "text": "月將卽是月建又爲月令。掌一月之權，司三旬之令。",
    "sha256": "6933a79f007770c732c5dc3bb9712be0e2e4506e62b4b7196208492ca011b94d",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2100331",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "LIUYAO_NAJIA"
    ],
    "raw_path": "data/reference/interpretation/zsby_16.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "ly:day",
    "title": "Tăng San Bốc Dịch · Nhật thần",
    "text": "沖旺相之靜爻，旣爲暗動，沖衰弱之靜爻爲日破",
    "sha256": "6d3623a2834828ff428848f02004e0e4a04a4fd8aa45ee083674f8a2fe7a984e",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2100338",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "LIUYAO_NAJIA"
    ],
    "raw_path": "data/reference/interpretation/zsby_17.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "zy:qian1",
    "title": "Chu Dịch · Càn · Sơ Cửu",
    "text": "潛龍勿用。",
    "sha256": "2efeb0a408474c8ae63170884b0dc957f02e8486322a2af1620c70d1dd891c76",
    "url": "https://zh.wikisource.org/w/index.php?oldid=2404991",
