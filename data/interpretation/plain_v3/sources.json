[
  {
    "id": "dtt:strength",
    "title": "Địch Thiên Tủy · Suy vượng",
    "text": "旺則宜洩宜傷，衰則喜幫喜助，子平之理也，然旺中有衰者存，不可損也。衰中有旺者存，不可益也。",
    "sha256": "82d6fd47d806ba24b672a3cb54034cc1dc522c81b5360961c0c43631631021d6",
    "url": "https://zh.wikisource.org/w/index.php?oldid=844360",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": "data/reference/bazi/dtt_strength.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "dtt:month",
    "title": "Địch Thiên Tủy · Nguyệt lệnh",
    "text": "月令提綱，譬之宅也，人元用事之神，宅之向也，不可以不卜。",
    "sha256": "0529be4cdaede0b047426f5651add5f5800a970fd6e915cdf01cea70d05fa224",
    "url": "https://zh.wikisource.org/w/index.php?oldid=844366",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": "data/reference/bazi/dtt_month.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "dtt:climate",
    "title": "Địch Thiên Tủy · Hàn noãn",
    "text": "天道有寒暖，發育萬物，人道得之，不可過也。",
    "sha256": "32b1264d49a00be96b7f6c4c76eaa7dba20af24f7d60c04089ef45bd089154a3",
    "url": "https://zh.wikisource.org/w/index.php?oldid=844365",
    "kind": "PRIMARY_TEXT",
    "methods": [
      "BAZI_NATAL_V1"
    ],
    "raw_path": "data/reference/bazi/dtt_climate.wikitext",
    "source_state": "PINNED_TRANSCRIPTION"
  },
  {
    "id": "smt:relations",
    "title": "Tam Mệnh Thông Hội · Luận tam hình",
    "text": "凡见刑不可便以凶论",
    "sha256": "8a5c0bfee3b3b8e2e2a6f354891067acdc72a977fc1ea366fe31b55ff3e02b94",
