 "nodes": [
  {
   "id": "file:research_tools/exponential_audit.py",
   "type": "file",
   "name": "exponential_audit.py",
   "filePath": "research_tools/exponential_audit.py",
   "summary": "Script CLI nghiên cứu so sánh các tham số beta của phân bố trọng số hàm mũ cho MVP 1: tính chính xác xác suất trên 125 ngữ cảnh P/Thể/Dụng, lấy mẫu Monte Carlo tái lập được và xuất báo cáo JSON/Markdown vào docs/research. Không thuộc luồng runtime.",
   "tags": [
    "entry-point",
    "nghiên-cứu",
    "audit",
    "monte-carlo",
    "báo-cáo"
   ],
   "complexity": "complex",
   "languageNotes": "Chạy dưới dạng module (`python3 -m research_tools.exponential_audit`) với relative import; đối chiếu chặt `config/mvp1_rules.json` và ghi SHA-256 của rule/config/mã nguồn để báo cáo có thể kiểm chứng."
  },
  {
   "id": "file:research_tools/weighted_sampling.py",
   "type": "file",
   "name": "weighted_sampling.py",
   "filePath": "research_tools/weighted_sampling.py",
   "summary": "Thư viện nghiên cứu liệt kê chính xác các cấu hình bucket (hành × chẵn/lẻ) cho bộ sáu số 00–45 và lấy mẫu tập con theo luật tích trọng số bằng đa thức đối xứng sơ cấp. Mô phỏng chấm điểm Âm Dương/Ngũ Hành, chọn hành giải cho Đại Hung và kiểm tra luật cứng, tách biệt với sampler runtime.",
   "tags": [
    "nghiên-cứu",
    "lấy-mẫu-có-trọng-số",
    "ngũ-hành",
    "xác-suất",
    "utility"
   ],
   "complexity": "complex",
   "languageNotes": "Dùng `@dataclass(frozen=True)` để Context/Configuration hashable làm khóa cho `lru_cache`; lấy mẫu tập con kích thước cố định qua đa thức đối xứng sơ cấp hậu tố, khác với bốc tuần tự có loại bỏ."
  },
