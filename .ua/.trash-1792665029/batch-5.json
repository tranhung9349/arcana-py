    "calendar"
   ],
   "complexity": "simple"
  },
  {
   "id": "file:calendar_adapter/audit.py",
   "type": "file",
   "name": "audit.py",
   "filePath": "calendar_adapter/audit.py",
   "summary": "Script kiểm toán offline cho adapter lịch Việt Nam cũ: quét cấu trúc toàn dải tra cứu và so sánh ngày sóc dự đoán với bảng pha trăng NASA (Espenak) đã tải về, xuất báo cáo JSON và luôn đánh dấu production_ready=False.",
