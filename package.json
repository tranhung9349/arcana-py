{
  "name": "arcana-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Local Tailwind CSS build for the Arcana FastAPI interface",
  "scripts": {
    "build:css": "tailwindcss -i ./web/styles/app.css -o ./web/style.css --minify",
    "watch:css": "tailwindcss -i ./web/styles/app.css -o ./web/style.css --watch",
    "test": "node --test tests/*.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "iztro": "2.6.1",
    "lunar-javascript": "1.7.7",
    "tsx": "4.23.15"
  }
}
